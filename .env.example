# 微信公众号同步配置
# 从 mp.weixin.qq.com → 设置与开发 → 基本配置 获取
WECHAT_APPID=your_appid_here
WECHAT_APPSECRET=your_appsecret_here

# 文章作者名（显示在公众号文章作者栏）
WECHAT_AUTHOR=Kay Ray

# 博客站点 URL（用于"阅读原文"链接，留空则不设置）
# 示例: https://your-blog.vercel.app
BLOG_URL=

# 默认封面图路径（当文章没有图片时使用，留空则跳过无图文章）
# 路径相对于项目根目录
# 示例: source/asserts/photos/default-cover.jpg
WECHAT_DEFAULT_COVER=
